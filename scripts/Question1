Question 1

# ============================================================
# What Variables influence the price 
# Diagnostics: DW, VIF, Shapiro, Anderson-Darling,
#              QQ plot, Residuals vs Fitted,
#              Breusch-Pagan, RESET test
# ============================================================

# ----- 0. Install & load packages ---------------------------
packages <- c("readxl", "lmtest", "car", "nortest", "ggplot2", "patchwork")
new_pkgs  <- packages[!packages %in% installed.packages()[, "Package"]]
if (length(new_pkgs)) install.packages(new_pkgs, dependencies = TRUE)

library(readxl)   # read Excel
library(lmtest)   # dwtest, bptest, resettest
library(car)      # vif
library(nortest)  # ad.test (Anderson-Darling)
library(ggplot2)  # plots
library(patchwork)# combine ggplots

# ----- 1. Load data -----------------------------------------
# Update the path below if your file is stored elsewhere

df <- read_excel("C:/Users/doaah/Downloads/eco/airbnb_with_guest_satisfaction.xlsx")


# ----- 2. Prepare variables ---------------------------------
# Ensure correct type
df$weekend          <- as.integer(df$weekend)
df$room_private     <- as.integer(df$room_private)
df$host_is_superhost<- as.integer(df$host_is_superhost)
df$city             <- as.factor(df$city)      # Amsterdam = ref
df$room_type        <- as.factor(df$room_type) # Entire home/apt = ref

# ----- 3. Fit model -----------------------------------------
# ----- 3. Fit model without log -----------------------------------------
model_full <- lm(
  price ~ guest_satisfaction_overall +  
    host_is_superhost + cleanliness_rating + weekend + room_type + person_capacity + bedrooms +
    city + dist + metro_dist ,
  data = df)
summary(model_full)
#########Checking Assumptions
# -----------------------------
# CHECK ASSUMPTIONS
# -----------------------------

# 1. Linearity + Homoscedasticity
plot(model_full$fitted.values, model_full$residuals,
     xlab = "Fitted Values", ylab = "Residuals")
abline(h = 0, col = "red")

# 2. Normality of residuals
qqnorm(model_full$residuals)
qqline(model_full$residuals, col = "red")

# Shapiro-Wilk test
shapiro.test(residuals(model_full))
#Anderson Darling
library(nortest)
ad.test(model_full$residuals)
# 3. Homoscedasticity
library(lmtest)
bptest(model_full)

# 4. Multicollinearity
library(car)
vif(model_full)

# 5. Independence of errors
durbinWatsonTest(model_full)

###Checking Specification
reset_result <- resettest(model_full, power = 2:3, type = "fitted")
print(reset_result)

###############
# ----- 3. Fit model with log for price -----------------------------------------
model_full_log <- lm(
  log_price ~ guest_satisfaction_overall + cleanliness_rating + 
    host_is_superhost + weekend + room_type + person_capacity + bedrooms +
    city + dist + metro_dist,
  data = df)
summary(model_full_log)

#########Checking Assumptions
# -----------------------------
# CHECK ASSUMPTIONS
# -----------------------------

# 1. Linearity + Homoscedasticity
plot(model_full_log$fitted.values, model_full_log$residuals,
     xlab = "Fitted Values", ylab = "Residuals")
abline(h = 0, col = "red")

# 2. Normality of residuals
qqnorm(model_full_log$residuals)
qqline(model_full_log$residuals, col = "red")

# Shapiro-Wilk test
shapiro.test(residuals(model_full_log))
#Anderson Darling
library(nortest)
ad.test(model_full_log$residuals)
# 3. Homoscedasticity
library(lmtest)
bptest(model_full_log)

# 4. Multicollinearity
library(car)
vif(model_full_log)

# 5. Independence of errors
durbinWatsonTest(model_full_log)

###Checking Specification
reset_result <- resettest(model_full_log, power = 2:3, type = "fitted")
print(reset_result)
