vif(model_inv_sqrt)

# 5. Independence of errors
durbinWatsonTest(model_inv_sqrt)

###Checking Specification
reset_result <- resettest(model_inv_sqrt, power = 2:3, type = "fitted")
print(reset_result)

#USing log price and fixing the hetro
#####Fixing Hetro
library(sandwich)
library(lmtest)
coeftest(model, vcov = vcovHC(model, type = "HC3"))


#Doing F-Test for with and without interaction to see if interaction is imp
model_without<-lm(log_price~ city+room_type, data=df)
summary(model_without)
anova(model,model_without)
#Model Without Interaction
bptest(model_without)


#Which explain more the room type or city non nested f test
#(discrimination approach)

model_city<-lm(log_price~ city, data=df)
summary(model_city)
AIC(model_city)
BIC(model_city)
model_room<-lm(log_price~room_type, data=df)
summary(model_room)
AIC(model_room)
BIC(model_room)
