#Fitting Model with log log price
model_log_log <- lm(log(log_price) ~ city * room_type, data = df)
print(summary(model_log_log))
# -----------------------------
# CHECK ASSUMPTIONS
# -----------------------------

# 1. Linearity + Homoscedasticity
