Question 2

# =============================================================================
#  TWO-WAY ANOVA VIA LM
#  Price ~ City + room_type + City:room_type
#  Full assumption checking suite
# =============================================================================
#Does log(Price) differ significantly by City and room type, and does their interaction matter?

# ---- 0. PACKAGES ------------------------------------------------------------
packages <- c("readxl", "ggplot2", "car", "emmeans", "ggpubr",
              "nortest", "lmtest", "moments", "dplyr", "tidyr")

installed <- packages %in% rownames(installed.packages())
if (any(!installed)) install.packages(packages[!installed],
                                      repos = "https://cran.r-project.org")

library(readxl)
library(ggplot2)
library(car)
library(emmeans)
library(ggpubr)
library(nortest)
library(lmtest)
library(moments)
library(tidyr)
library(dplyr)   # last — prevents select() masking


# =============================================================================
# SECTION 1 — LOAD & PREPARE DATA
# =============================================================================

df <- read_excel("C:/Users/noura/Downloads/airbnb_with_guest_satisfaction.xlsx")

# Factor coercion
df$city      <- factor(df$city,      levels = c("Amsterdam", "Lisbon"))
df$room_type <- factor(df$room_type, levels = c("Entire home/apt", "Private room"))
# Numeric coercion
df$price     <- as.numeric(df$price)
df$log_price <- as.numeric(df$log_price)


# =============================================================================
# SECTION 2 — FIT THE LM MODEL
# =============================================================================

options(contrasts = c("contr.sum", "contr.poly"))

#first model price without any tranformation
model_without_log <- lm(price ~ city * room_type, data = df)
print(summary(model_without_log))

# -----------------------------
# CHECK ASSUMPTIONS
# -----------------------------

# 1. Linearity + Homoscedasticity
plot(model_without_log$fitted.values, model_without_log$residuals,
     xlab = "Fitted Values", ylab = "Residuals")
abline(h = 0, col = "red")

# 2. Normality of residuals
qqnorm(model_without_log$residuals)
qqline(model_without_log$residuals, col = "red")

# Shapiro-Wilk test
shapiro.test(residuals(model_without_log))
#Anderson Darling
library(nortest)
ad.test(model_without_log$residuals)
# 3. Homoscedasticity
library(lmtest)
bptest(model_without_log)

# 4. Multicollinearity
library(car)
vif(model_without_log)

# 5. Independence of errors
durbinWatsonTest(model_without_log)

###Checking Specification
reset_result <- resettest(model_without_log, power = 2:3, type = "fitted")
print(reset_result)


#Fiting Model with log for price
model <- lm(log_price ~ city * room_type, data = df)
print(summary(model))
# -----------------------------
# CHECK ASSUMPTIONS
# -----------------------------

# 1. Linearity + Homoscedasticity
plot(model$fitted.values, model$residuals,
     xlab = "Fitted Values", ylab = "Residuals")
abline(h = 0, col = "red")

# 2. Normality of residuals
qqnorm(model$residuals)
qqline(model$residuals, col = "red")

# Shapiro-Wilk test
shapiro.test(residuals(model))
#Anderson Darling
library(nortest)
ad.test(model$residuals)
# 3. Homoscedasticity
library(lmtest)
bptest(model)
lt <- leveneTest(log_price ~ city * room_type, data = df, center = mean)
print(lt)
# 4. Multicollinearity
library(car)
vif(model)

# 5. Independence of errors
durbinWatsonTest(model)

###Checking Specification
reset_result <- resettest(model, power = 2:3, type = "fitted")
print(reset_result)


#Fitting Model with SQRT fo price
