#Fitting model of 1/log price
model_1_over_log<- lm(I(1/log_price) ~ city * room_type, data = df)
print(summary(model_1_over_log))
# -----------------------------
# CHECK ASSUMPTIONS
# -----------------------------

# 1. Linearity + Homoscedasticity
plot(model_1_over_log$fitted.values, model_1_over_log$residuals,
     xlab = "Fitted Values", ylab = "Residuals")
abline(h = 0, col = "red")

# 2. Normality of residuals
qqnorm(model_1_over_log$residuals)
qqline(model_1_over_log$residuals, col = "red")

# Shapiro-Wilk test
shapiro.test(residuals(model_1_over_log))
#Anderson Darling
library(nortest)
ad.test(model_1_over_log$residuals)
# 3. Homoscedasticity
library(lmtest)
bptest(model_1_over_log)

# 4. Multicollinearity
library(car)
vif(model_1_over_log)

# 5. Independence of errors
durbinWatsonTest(model_1_over_log)

###Checking Specification
reset_result <- resettest(model_1_over_log, power = 2:3, type = "fitted")
print(reset_result)

#fitting 1/sqrt price
model_inv_sqrt <- lm(I(1 / sqrt(price)) ~ city*room_type,data = df)

summary(model_inv_sqrt)
# -----------------------------
